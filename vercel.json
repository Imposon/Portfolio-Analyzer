{
  "version": 2,
  "builds": [
    {
      "src": "fintech-dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/fintech-dashboard/$1"
    }
  ],
  "env": {
    "PYTHONPATH": "/api"
  }
}
